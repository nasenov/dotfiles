{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "github>nasenov/dotfiles//.renovate/labels.json",
    "github>nasenov/dotfiles//.renovate/semanticCommits.json",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Sofia)"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
